    {
      "label": "Clean CoolingControl",
      "type": "shell",
      "command": "dotnet clean -c Release; dotnet clean -c Debug; Remove-Item -Recurse -Force ${workspaceFolder}/CoolingControl/publish/*; Remove-Item -Recurse -Force ${workspaceFolder}/CoolingControl/bin/*/*/*/plugins/*",
