      "presentation": {
        "reveal": "always"
      }
    },    
    {
      "label": "Publish CoolingControl net8.0",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "CoolingControl/CoolingControl.csproj",
        "-c",
        "Release",
        "-f",
        "net8.0-windows",
        "-r",
        "win-x64",
        "--no-self-contained",
        "--output",
        "CoolingControl/publish"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["Clean CoolingControl", "Build CoolingControl Release", "Publish CoolingControl.LHMPlugin net8.0", "Publish CoolingControl.DS18B20Plugin net8.0"],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always"
      }
    },
